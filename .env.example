# ============================================================
# VEIL — ENVIRONMENT CONFIGURATION
# ============================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel & Next.js)
# In development: http://localhost:8000
# In production: https://your-production-backend.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. BACKEND CORS
# Allowed frontend origins (comma-separated for multiple domains)
# Example for production: https://veil.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# 3. LLM PROVIDER CONFIGURATION
# Supported options: OLLAMA_LOCAL, OLLAMA_CLOUD, API
LLM_PROVIDER=OLLAMA_LOCAL

# For OLLAMA_LOCAL (default laptop development):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_API_KEY=

# For API (Cloud LLM e.g. Groq, Gemini, OpenAI in production):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# 4. MOSS SEMANTIC RETRIEVAL LAYER
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=veil-knowledge
MOSS_MODEL_ID=moss-minilm

# 5. BACKEND RUNTIME CONFIGURATION
PORT=8000
HOST=0.0.0.0
DEBUG=false
