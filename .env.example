# VEIL Environment Configuration

# Moss Credentials (Get from https://moss.dev)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_DEFAULT_INDEX=veil-default

# LLM Configuration
# Supported providers: gemini, groq, openai, anthropic, local
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Backend Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true
DATA_DIR=./data
