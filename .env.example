# ============================================================
# VEIL — ENVIRONMENT CONFIGURATION
# ============================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel & Next.js)
# In development: http://localhost:8000
# In production: https://your-production-backend.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. BACKEND CORS
# Allowed frontend origins (comma-separated for multiple domains)
FRONTEND_URL=http://localhost:3000

# 3. PRIMARY AI ENGINE: GOOGLE GEMINI API
LLM_PROVIDER=GEMINI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# 4. MOSS RETRIEVAL LAYER (OFFICIAL MOSS SDK / RUST CORE)
MOSS_PROJECT_ID=YOUR_MOSS_PROJECT_ID_HERE
MOSS_PROJECT_KEY=YOUR_MOSS_PROJECT_KEY_HERE
MOSS_INDEX_NAME=veil-knowledge
MOSS_MODEL_ID=moss-minilm

# 5. BACKEND RUNTIME CONFIGURATION
PORT=8000
HOST=0.0.0.0
DEBUG=false
