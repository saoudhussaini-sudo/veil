# ==============================================================================
# VEIL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# AI Provider: "gemini" (Cloud / Vercel default) or "ollama" (Local fallback)
AI_PROVIDER=gemini

# Optional: Local Backend URL if running FastAPI (leave blank for Vercel serverless)
BACKEND_URL=
